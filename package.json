{
  "name": "snova-v-sssr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Сайт ресторана советской кухни «Снова в СССР» — Vue 3 + TypeScript + Vite, REST API и админ-панель.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "start:api": "tsx server/src/index.ts",
    "typecheck": "vue-tsc --build"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "tsx": "^4.20.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  }
}
